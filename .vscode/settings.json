{
  "files.autoSave": "afterDelay",
  "editor.tabSize": 2,
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingComments": "always",
  "editor.autoClosingDelete": "always",
  "editor.autoClosingQuotes": "always",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "diffEditor.codeLens": true,
  "files.autoSaveDelay": 2000,
  "files.autoSaveWorkspaceFilesOnly": true,
  "files.insertFinalNewline": true,
  "workbench.activityBar.location": "default",
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vs-seti",
  "workbench.sideBar.location": "left",
  "workbench.statusBar.visible": true,
  "workbench.tips.enabled": true,
  "workbench.tree.enableStickyScroll": false,
  "workbench.editor.editorActionsLocation": "default",
  "workbench.settings.editor": "ui",
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#7202da",
    "titleBar.inactiveBackground": "#458fff",
    "titleBar.inactiveForeground": "#ffffff",
    "statusBar.background": "#0258da",
    "activityBar.activeBackground": "#1b1b1b",
    "activityBar.background": "#01275f",
    "terminal.background": "#000000"
    // Add more color customizations here
  },
  "window.density.editorTabHeight": "default",
  "prettier.bracketSameLine": true,
  "prettier.documentSelectors": [
    "*.js, *.jsx, *.tsx, *.htm, *.html, *.scss, *.css, *.json, *.md, *.gitignore"
  ],
  "prettier.experimentalTernaries": true,
  "prettier.jsxSingleQuote": true,
  "prettier.singleAttributePerLine": true,
  "prettier.singleQuote": true,
  "javascript.format.insertSpaceAfterCommaDelimiter": true,
  "javascript.format.enable": true,
  "javascript.autoClosingTags": true,
  "javascript.format.insertSpaceAfterConstructor": true,
  "javascript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": true,
  "javascript.format.insertSpaceAfterKeywordsInControlFlowStatements": true,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": true,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingJsxExpressionBraces": true,
  "terminal.integrated.confirmOnExit": "always",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.enableVisualBell": true,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.profiles.windows": {
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": ["/K", "prompt $G"],
      "icon": "terminal-cmd"
    }
  },
  "workbench.panel.showLabels": false,
  "workbench.panel.defaultLocation": "right"
}
